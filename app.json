{
  "expo": {
    "name": "Reporte Ciudadano",
    "slug": "unermobilegrupo3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unermobilegrupo3",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.sergioortegadev.unermobilegrupo3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FF9117"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "app.sergioortegadev.unermobilegrupo3",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/guale/muni-logo.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/guale/muni-logo.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir a $(PRODUCT_NAME) acceder al micrófono para grabar audios."
        }
      ],
      "expo-asset",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos la cámara para que saques la foto del problema que reportas.",
          "photosPermission": "Accedemos a tus fotos para que adjuntes una imagen del problema."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Esta aplicación necesita acceder a tu ubicación para geolocalizar los reportes."
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FF9117",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94cf05ec-2f08-433f-86ac-bed44611c5ea"
      }
    },
    "owner": "sergioortegadev"
  }
}
